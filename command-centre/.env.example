# UNIRES Command Centre — Environment Configuration
# Copy to .env.local and fill in values

# Supabase connection (local: supabase start, or hosted project)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Demo mode: uses in-memory data, no Supabase required
VITE_DEMO_MODE=true

# MapLibre basemap style URL
VITE_BASEMAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_BASEMAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
