# ONE ROOF - Backend environment template (Person 5B scope)
# Copy to .env and adjust. NEVER commit the real .env.
#   cp .env.example .env

# -- General ---------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=One Roof API

# -- MinIO / S3 media storage ----------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oneroof-uploads
MINIO_REGION=us-east-1
MINIO_USE_PRESIGNED_URLS=true
MINIO_PRESIGN_EXPIRY_SECONDS=3600

# -- Redis -----------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_INCIDENT_CHANNEL=incident_updates

# -- JWT -------------------------------------------------------
# Generate a real secret before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# -- OTP -------------------------------------------------------
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
# Prints the OTP to the terminal. Development only.
OTP_PRINT_TO_CONSOLE=true

# -- Uploads ---------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# -- Person 5A (database) --------------------------------------
# Owned by Person 5A. Listed here only so the shared .env is
# complete; app/config.py ignores unknown keys.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oneroof
