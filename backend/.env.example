# ONE ROOF - Backend environment template
# Copy to .env and adjust. NEVER commit the real .env.

ENVIRONMENT=development
DEBUG=true
APP_NAME=One Roof API

# Person 5A: PostgreSQL/PostGIS and deduplication
DATABASE_URL=postgresql://oneroof:oneroof@localhost:5432/oneroof
DEDUPE_RADIUS_METERS=500
DEDUPE_TIME_WINDOW_MINUTES=30
CLOSURE_PHOTO_MAX_DISTANCE_METERS=250

# Optional hosted/self-hosted Supabase project metadata. DATABASE_URL should
# point to its PostgreSQL connection pool when Supabase is used.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MinIO / S3 media storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oneroof-uploads
MINIO_REGION=us-east-1
MINIO_USE_PRESIGNED_URLS=true
MINIO_PRESIGN_EXPIRY_SECONDS=3600

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_INCIDENT_CHANNEL=incident_updates

# JWT and OTP
JWT_SECRET_KEY=change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
OTP_PRINT_TO_CONSOLE=true

# Uploads
MAX_UPLOAD_SIZE_MB=10
